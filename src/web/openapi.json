  "components": {
    "schemas": {
      "AbsenceReview": {
        "properties": {
          "outcome": {
            "type": "string",
            "pattern": "^(confirmed|excused)$",
            "title": "Outcome"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "AbsenceReview"
      },
      "Acceptance": {
        "type": "string",
        "enum": [
          "pending",
          "accepted",
          "declined",
          "expired"
        ],
        "title": "Acceptance"
      },
      "AttendanceIn": {
        "properties": {
          "student_id": {
            "type": "integer",
            "title": "Student Id"
          },
          "company_id": {
            "type": "integer",
            "title": "Company Id"
          },
          "event": {
            "type": "string",
            "pattern": "^(ppt|test|interview|other)$",
            "title": "Event"
          },
          "attended": {
            "type": "boolean",
            "title": "Attended"
          },
          "emergency_exception": {
            "type": "boolean",
            "title": "Emergency Exception",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "company_id",
          "event",
          "attended"
        ],
        "title": "AttendanceIn"
      },
      "Category": {
        "type": "string",
        "enum": [
          "A+",
          "A",
          "B",
          "C"
        ],
        "title": "Category"
      },
      "CompanyIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "category"
        ],
        "title": "CompanyIn"
      },
      "Course": {
        "type": "string",
        "enum": [
          "M.Tech CS",
          "M.Tech AIDS",
          "B.Tech-M.Tech CS",
          "M.Sc CS",
          "M.Sc DFIS"
        ],
        "title": "Course"
      },
      "EligibilityStatus": {
        "type": "string",
        "enum": [
          "eligible",
          "ineligible",
          "pending_verification"
        ],
        "title": "EligibilityStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Joining": {
        "type": "string",
        "enum": [
          "pending",
          "joined",
          "not_joined"
        ],
        "title": "Joining"
      },
      "LoginIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn"
      },
      "OfferCreate": {
        "properties": {
          "student_id": {
            "type": "integer",
            "title": "Student Id"
          },
          "company_id": {
            "type": "integer",
            "title": "Company Id"
          },
          "offer_type": {
            "$ref": "#/components/schemas/OfferType"
          },
          "ctc_lpa": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ctc Lpa"
          },
          "stipend_amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
